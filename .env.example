# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API (or "Connect" → App frameworks).
# Only the public URL and the publishable (anon) key belong here — never the
# service_role / secret key or your database password.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
